---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 8);
---
<Base
  title="Software systems, data infrastructure, and reliability"
  description="Technical notes about software engineering, distributed systems, data infrastructure, reliability, and production systems."
>
  <h1>Ahmed Sheta</h1>
  <p>
    I'm a software engineer. I write about distributed systems, data infrastructure,
    reliability, databases, and production software.
  </p>

  <h2>Latest writing</h2>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <h2><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2>
        <div class="muted">
          <span class="level">{post.data.level}</span> ·
          <time datetime={post.data.published.toISOString()}>{post.data.published.toISOString().slice(0, 10)}</time>
        </div>
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>

  <p><a href="/posts/">All posts →</a></p>
</Base>
