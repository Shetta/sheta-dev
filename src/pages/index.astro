---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 8);
---
<Base>
  <h1>Ahmed Sheta</h1>
  <p>
    Software engineer. I write about distributed systems, data infrastructure,
    reliability, and whatever I am trying to understand deeply enough to explain simply.
  </p>

  <h2>Writing</h2>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <h2><a href={`/posts/${post.id}`}>{post.data.title}</a></h2>
        <div class="muted">{post.data.published.toISOString().slice(0, 10)}</div>
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>

  <p><a href="/posts">All posts →</a></p>
</Base>
