---
import { getCollection, render } from 'astro:content';
import Feedback from '../../components/Feedback.astro';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const availablePosts = await getCollection('posts', ({ data }) => !data.draft);
const postsById = new Map(availablePosts.map((entry) => [entry.id, entry]));
const prerequisites = post.data.prerequisites
  .map((id) => postsById.get(id))
  .filter((entry) => entry !== undefined);
const nextPost = post.data.nextPost ? postsById.get(post.data.nextPost) : undefined;
const published = post.data.published.toISOString().slice(0, 10);
const updated = post.data.updated?.toISOString().slice(0, 10);
const canonicalUrl = new URL(`/posts/${post.id}/`, Astro.site).toString();
const postImage = post.data.image ?? `/social/${post.id}.png`;
const prose = (post.body ?? '').replace(/```[\s\S]*?```/g, '').replace(/<[^>]+>/g, '');
const readingMinutes = Math.max(1, Math.ceil(prose.trim().split(/\s+/).length / 220));
const toc = headings.filter(({ depth }) => depth >= 2 && depth <= 3);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: published,
  dateModified: updated ?? published,
  mainEntityOfPage: canonicalUrl,
  url: canonicalUrl,
  author: { '@type': 'Person', name: 'Ahmed Sheta', url: new URL('/about/', Astro.site).toString() },
  keywords: post.data.tags,
  image: new URL(postImage, Astro.site).toString()
};
---
<Base
  title={post.data.title}
  description={post.data.description}
  markdownUrl={`/posts/${post.id}.md`}
  type="article"
  publishedTime={post.data.published.toISOString()}
  modifiedTime={(post.data.updated ?? post.data.published).toISOString()}
  tags={post.data.tags}
  image={postImage}
  imageAlt={post.data.imageAlt ?? `Preview image for ${post.data.title}`}
  jsonLd={jsonLd}
>
  <article>
    <h1>{post.data.title}</h1>
    <div class="meta">
      <div>
        By <a href="/about/">Ahmed Sheta</a> · <span class="level">{post.data.level}</span>
      </div>
      <div>
        Published <time datetime={post.data.published.toISOString()}>{published}</time>
        {updated && <> · Updated <time datetime={post.data.updated?.toISOString()}>{updated}</time></>}
      </div>
      <div>{readingMinutes} min read · <a href={`/posts/${post.id}.md`}>Markdown</a></div>
      {post.data.series && <div>Series: {post.data.series}</div>}
      {prerequisites.length > 0 && (
        <div>
          Prerequisite: {prerequisites.map((entry, index) => (
            <>{index > 0 && ', '}<a href={`/posts/${entry.id}/`}>{entry.data.title}</a></>
          ))}
        </div>
      )}
      {post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
        </div>
      )}
    </div>
    {post.data.scenarioNote && (
      <aside class="scenario-note" aria-label="Scenario note">
        <strong>Scenario note:</strong> {post.data.scenarioNote}
      </aside>
    )}
    {toc.length >= 4 && (
      <nav class="table-of-contents" aria-labelledby="contents-heading">
        <h2 id="contents-heading">Contents</h2>
        <ol>
          {toc.map((heading) => <li class={`toc-depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
        </ol>
      </nav>
    )}
    <Content />
    {nextPost && (
      <aside class="next-reading" aria-labelledby="next-reading-heading">
        <h2 id="next-reading-heading">Next</h2>
        <p><a href={`/posts/${nextPost.id}/`}>{nextPost.data.title}</a></p>
        <p>{nextPost.data.description}</p>
      </aside>
    )}
  </article>
  <Feedback title={post.data.title} articleUrl={canonicalUrl} />
  <script>
    document.querySelectorAll<HTMLElement>('article h2[id], article h3[id]').forEach((heading) => {
      if (heading.closest('.table-of-contents, .next-reading')) return;
      const permalink = document.createElement('a');
      permalink.className = 'heading-permalink';
      permalink.href = `#${heading.id}`;
      permalink.setAttribute('aria-label', `Permalink to ${heading.textContent ?? 'this section'}`);
      permalink.textContent = '#';
      const label = document.createElement('span');
      label.id = `${heading.id}-label`;
      label.append(...heading.childNodes);
      heading.setAttribute('aria-labelledby', label.id);
      heading.append(label);
      heading.append(permalink);
    });
    document.querySelectorAll('article pre').forEach((pre) => {
      const code = pre.querySelector('code');
      if (!code) return;
      const language = [...code.classList].find((name) => name.startsWith('language-'))?.slice(9) ?? 'text';
      const toolbar = document.createElement('div');
      toolbar.className = 'code-toolbar';
      const label = document.createElement('span');
      label.textContent = language;
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = 'Copy';
      button.setAttribute('aria-label', `Copy ${language} code`);
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.textContent ?? '');
          button.textContent = 'Copied';
        } catch {
          button.textContent = 'Copy failed';
        }
        window.setTimeout(() => { button.textContent = 'Copy'; }, 1500);
      });
      toolbar.append(label, button);
      pre.before(toolbar);
    });
  </script>
</Base>
