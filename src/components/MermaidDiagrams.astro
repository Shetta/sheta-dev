<script is:inline type="module">
  const blocks = document.querySelectorAll('pre > code.language-mermaid');

  if (blocks.length > 0) {
    try {
      const { default: mermaid } = await import(
        'https://cdn.jsdelivr.net/npm/mermaid@11.16.1/dist/mermaid.esm.min.mjs'
      );

      const iconNames = new Set();

      for (const code of blocks) {
        for (const match of code.textContent?.matchAll(/\blogos:([a-z0-9]+(?:-[a-z0-9]+)*)\b/g) ?? []) {
          iconNames.add(match[1]);
        }
      }

      if (iconNames.size > 0) {
        mermaid.registerIconPacks([
          {
            name: 'logos',
            loader: async () => {
              const response = await fetch(
                `https://api.iconify.design/logos.json?icons=${[...iconNames].join(',')}`
              );

              if (!response.ok) {
                throw new Error(`Icon request failed with status ${response.status}`);
              }

              return response.json();
            }
          }
        ]);
      }

      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'default'
      });

      for (const [index, code] of blocks.entries()) {
        const source = code.textContent?.trim();
        const fallback = code.parentElement;

        if (!source || !(fallback instanceof HTMLPreElement)) continue;

        const diagram = document.createElement('div');
        diagram.className = 'mermaid-diagram';
        diagram.hidden = true;
        fallback.insertAdjacentElement('afterend', diagram);

        const renderId = `mermaid-diagram-${index}`;

        try {
          const { svg, bindFunctions } = await mermaid.render(renderId, source);
          diagram.innerHTML = svg;
          bindFunctions?.(diagram);
          diagram.hidden = false;
          fallback.hidden = true;
        } catch (error) {
          diagram.remove();
          document.getElementById(`d${renderId}`)?.remove();
          console.error('Mermaid could not render a diagram.', error);
        }
      }
    } catch (error) {
      console.error('Mermaid could not load. Diagram source remains visible.', error);
    }
  }
</script>
