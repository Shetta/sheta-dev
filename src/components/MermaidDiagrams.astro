<script is:inline type="module">
  const blocks = [...document.querySelectorAll('pre > code.language-mermaid')];

  if (blocks.length > 0) {
    try {
      const { default: mermaid } = await import(
        'https://cdn.jsdelivr.net/npm/mermaid@11.16.1/dist/mermaid.esm.min.mjs'
      );

      const appearances = {
        light: {
          darkMode: false,
          background: '#ffffff',
          primaryColor: '#e8f0fe',
          primaryTextColor: '#111111',
          primaryBorderColor: '#174ea6',
          lineColor: '#333333',
          clusterBkg: '#f5f5f5',
          clusterBorder: '#666666'
        },
        dark: {
          darkMode: true,
          background: '#171717',
          primaryColor: '#263957',
          primaryTextColor: '#ffffff',
          primaryBorderColor: '#aecbfa',
          lineColor: '#eeeeee',
          clusterBkg: '#202124',
          clusterBorder: '#aaaaaa'
        },
        contrast: {
          darkMode: true,
          background: '#000000',
          primaryColor: '#000000',
          primaryTextColor: '#ffffff',
          primaryBorderColor: '#ffff00',
          lineColor: '#ffffff',
          clusterBkg: '#000000',
          clusterBorder: '#ffffff'
        }
      };

      const currentAppearance = () => {
        const selected = document.documentElement.dataset.theme;
        if (selected === 'contrast') return 'contrast';
        if (selected === 'dark') return 'dark';
        if (selected === 'light') return 'light';
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };

      let renderNumber = 0;
      const renderAll = async () => {
        const appearance = currentAppearance();
        mermaid.initialize({
          startOnLoad: false,
          securityLevel: 'strict',
          theme: 'base',
          themeVariables: appearances[appearance]
        });

        for (const [index, code] of blocks.entries()) {
          const source = code.textContent?.trim();
          const fallback = code.parentElement;
          if (!source || !(fallback instanceof HTMLPreElement)) continue;

          let diagram = fallback.nextElementSibling;
          if (!(diagram instanceof HTMLElement) || !diagram.classList.contains('mermaid-diagram')) {
            diagram = document.createElement('div');
            diagram.className = 'mermaid-diagram';
            fallback.insertAdjacentElement('afterend', diagram);
          }

      const selectedTheme = document.documentElement.dataset.theme;
      const useDarkTheme = selectedTheme === 'dark' || selectedTheme === 'contrast'
        || (!selectedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches);

      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: useDarkTheme ? 'dark' : 'default'
      });

      await renderAll();
      document.addEventListener('colour-theme-change', renderAll);
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        if (!document.documentElement.dataset.theme || document.documentElement.dataset.theme === 'system') {
          renderAll();
        }
      });
    } catch (error) {
      console.error('Mermaid could not load. Diagram source remains visible.', error);
    }
  }
</script>
