<details class="reading-options">
  <summary>Reading options</summary>
  <aside class="accessibility-tools" aria-label="Accessibility tools">
    <label for="colour-theme">Colour theme</label>
    <select id="colour-theme">
      <option value="system">System</option>
      <option value="light">Light</option>
      <option value="dark">Dark</option>
      <option value="contrast">High contrast</option>
    </select>
    <button id="read-page" type="button" aria-pressed="false">Read page aloud</button>
    <button id="stop-reading" type="button" hidden>Stop reading</button>
    <label id="voice-label" for="reading-voice" hidden>Voice</label>
    <select id="reading-voice" hidden></select>
    <button id="preview-voice" type="button" hidden>Preview voice</button>
    <span id="speech-status" class="visually-hidden" role="status" aria-live="polite"></span>
  </aside>
</details>

<script>
  const theme = document.querySelector<HTMLSelectElement>('#colour-theme');
  const readButton = document.querySelector<HTMLButtonElement>('#read-page');
  const stopButton = document.querySelector<HTMLButtonElement>('#stop-reading');
  const status = document.querySelector<HTMLElement>('#speech-status');
  const voiceLabel = document.querySelector<HTMLLabelElement>('#voice-label');
  const voiceSelect = document.querySelector<HTMLSelectElement>('#reading-voice');
  const previewButton = document.querySelector<HTMLButtonElement>('#preview-voice');
  const storageKey = 'colour-theme';

  if (theme) {
    const savedTheme = localStorage.getItem(storageKey);
    theme.value = ['light', 'dark', 'contrast'].includes(savedTheme ?? '') ? savedTheme! : 'system';
    theme.addEventListener('change', () => {
      const selected = theme.value;
      document.documentElement.dataset.theme = selected;
      if (selected === 'system') localStorage.removeItem(storageKey);
      else localStorage.setItem(storageKey, selected);
      document.dispatchEvent(new CustomEvent('colour-theme-change'));
    });
  }

  if (!('speechSynthesis' in window)) {
    readButton?.setAttribute('hidden', '');
  } else if (readButton && stopButton && status && voiceSelect && voiceLabel && previewButton) {
    const voiceStorageKey = 'reading-voice';
    let voices: SpeechSynthesisVoice[] = [];
    let speechSession = 0;

    type VoiceQuality = 'Natural' | 'Enhanced' | 'Standard';

    const voiceQuality = (voice: SpeechSynthesisVoice): VoiceQuality => {
      const name = voice.name.toLowerCase();
      if (/\b(natural|neural)\b/.test(name)) return 'Natural';
      if (/\b(enhanced|premium)\b/.test(name) || /\b(samantha|alex)\b/.test(name)) return 'Enhanced';
      return 'Standard';
    };

    const voiceScore = (voice: SpeechSynthesisVoice) => {
      const name = voice.name.toLowerCase();
      const quality = voiceQuality(voice);
      let score = quality === 'Natural' ? 300 : quality === 'Enhanced' ? 200 : 0;

      // Microsoft exposes its highest-quality Edge voices as Online (Natural).
      if (/microsoft/.test(name) && /\bonline\b/.test(name)) score += 70;
      else if (/\bonline\b/.test(name)) score += 50;
      if (/\b(ava|andrew|aria|jenny|emma|brian)\b/.test(name)) score += 25;
      if (/google.*english/.test(name)) score += 15;
      if (voice.lang.toLowerCase() === 'en-us') score += 10;
      if (!voice.localService) score += 20;
      return score;
    };

    const loadVoices = () => {
      const uniqueVoices = new Map<string, SpeechSynthesisVoice>();
      speechSynthesis.getVoices()
        .filter((voice) => voice.lang.toLowerCase().startsWith('en'))
        .forEach((voice) => uniqueVoices.set(voice.voiceURI, voice));
      voices = [...uniqueVoices.values()].sort((a, b) =>
        voiceScore(b) - voiceScore(a) || a.name.localeCompare(b.name),
      );
      voiceSelect.replaceChildren(...voices.map((voice) => {
        const option = document.createElement('option');
        const quality = voiceQuality(voice);
        option.value = voice.voiceURI;
        option.textContent = `${voice.name} — ${voice.lang}${quality === 'Standard' ? '' : ` · ${quality}`}`;
        return option;
      }));
      const savedVoice = localStorage.getItem(voiceStorageKey);
      voiceSelect.value = voices.some((voice) => voice.voiceURI === savedVoice)
        ? savedVoice!
        : voices[0]?.voiceURI ?? '';
      const showPicker = voices.length > 1;
      voiceLabel.hidden = !showPicker;
      voiceSelect.hidden = !showPicker;
      previewButton.hidden = !showPicker;
    };
    loadVoices();
    speechSynthesis.addEventListener('voiceschanged', loadVoices);
    voiceSelect.addEventListener('change', () => {
      const selectedVoice = voices.find((voice) => voice.voiceURI === voiceSelect.value);
      if (selectedVoice) localStorage.setItem(voiceStorageKey, selectedVoice.voiceURI);
    });

    const selectedVoice = () =>
      voices.find((voice) => voice.voiceURI === voiceSelect.value) ?? voices[0] ?? null;

    const speak = (text: string, session: number, onEnd?: () => void) => {
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.voice = selectedVoice();
      utterance.lang = utterance.voice?.lang || document.documentElement.lang || 'en';
      utterance.rate = 0.95;
      utterance.pitch = 1;
      if (onEnd) utterance.addEventListener('end', () => {
        if (session === speechSession) onEnd();
      });
      utterance.addEventListener('error', (event) => {
        if (session === speechSession && event.error !== 'canceled' && event.error !== 'interrupted') {
          finish('The selected voice could not continue reading.');
        }
      });
      speechSynthesis.speak(utterance);
    };

    const speakSections = (sections: string[], session: number, index = 0) => {
      if (session !== speechSession) return;
      if (index >= sections.length) {
        finish('Reading finished.');
        return;
      }
      speak(sections[index], session, () => speakSections(sections, session, index + 1));
    };

    const finish = (message: string) => {
      readButton.setAttribute('aria-pressed', 'false');
      readButton.textContent = 'Read page aloud';
      stopButton.hidden = true;
      status.textContent = message;
    };

    readButton.addEventListener('click', () => {
      if (speechSynthesis.paused) {
        speechSynthesis.resume();
        readButton.textContent = 'Pause reading';
        readButton.setAttribute('aria-pressed', 'true');
        status.textContent = 'Reading resumed.';
        return;
      }
      if (speechSynthesis.speaking) {
        speechSynthesis.pause();
        readButton.textContent = 'Resume reading';
        readButton.setAttribute('aria-pressed', 'false');
        status.textContent = 'Reading paused.';
        return;
      }

      const readableContent = (document.querySelector('article') ?? document.querySelector('main'))?.cloneNode(true);
      if (!(readableContent instanceof HTMLElement)) return;
      readableContent.querySelectorAll('script, style, nav, aside, form, [aria-hidden="true"], .mermaid').forEach((element) => element.remove());
      readableContent.querySelectorAll('pre').forEach((element) => {
        const announcement = document.createElement('p');
        announcement.textContent = 'Code example.';
        element.replaceWith(announcement);
      });
      const sections = [...readableContent.querySelectorAll('h1, h2, h3, p, li, blockquote')]
        .filter((element) => !element.parentElement?.closest('li, blockquote'))
        .map((element) => element.textContent?.replace(/\s+/g, ' ').trim())
        .filter((text): text is string => Boolean(text));
      if (sections.length === 0) return;
      // Queue one semantic section at a time. This gives the synthesizer natural
      // pauses and avoids browsers dropping items from a large utterance queue.
      speechSession += 1;
      speakSections(sections, speechSession);
      readButton.textContent = 'Pause reading';
      readButton.setAttribute('aria-pressed', 'true');
      stopButton.hidden = false;
      status.textContent = 'Reading started.';
    });

    previewButton.addEventListener('click', () => {
      speechSession += 1;
      speechSynthesis.cancel();
      speak('This is a preview of the selected reading voice.', speechSession, () => finish('Voice preview finished.'));
      readButton.textContent = 'Read page aloud';
      readButton.setAttribute('aria-pressed', 'false');
      stopButton.hidden = false;
      status.textContent = 'Playing voice preview.';
    });

    stopButton.addEventListener('click', () => {
      speechSession += 1;
      speechSynthesis.cancel();
      finish('Reading stopped.');
    });

    window.addEventListener('pagehide', () => speechSynthesis.cancel());
  }
</script>
